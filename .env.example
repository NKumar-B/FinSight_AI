# PostgreSQL Credentials
SPRING_DATASOURCE_USERNAME=finsight_user
SPRING_DATASOURCE_PASSWORD=finsight_secure_pass_2026
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Service Database Names
DB_AUTH=finsight_auth
DB_FINANCIAL=finsight_financial_data
