FINSIGHT_JWT_EXPIRATION_MS=86400000
FINSIGHT_JWT_REFRESH_EXPIRATION_MS=604800000

# ChaCha20-Poly1305 Data-at-Rest Encryption Key (Base64-encoded 256-bit key)
