{
  "info": {
    "name": "FinSight AI - Complete Enterprise API Collection",
    "description": "Comprehensive Postman collection for the FinSight AI microservices architecture, featuring Auth, Financial Data, Deterministic Reconciliation, Fraud Detection, Audit & Reporting, Financial Insights, and 9 Specialist AI Orchestrator Agents.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "account_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "run_reference",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Auth Service",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"analyst@finsight.local\",\n  \"username\": \"analyst_john\",\n  \"password\": \"SecurePass2026!\",\n  \"fullName\": \"John Doe\",\n  \"roleNames\": [\"ROLE_FINANCIAL_ANALYST\"]\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/register",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Auto-set JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.data.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.data.refreshToken);",
                  "    console.log('JWT Token successfully stored in collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"AdminSecure2026!\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/login",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/refresh",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/users/me",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "users", "me"]
            }
          }
        },
        {
          "name": "Forgot Password (Request OTP via Email/Mobile)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"analyst@finsight.local\",\n  \"deliveryChannel\": \"EMAIL\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/forgot-password",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"analyst@finsight.local\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/verify-otp",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Reset Password with OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"analyst@finsight.local\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewSecurePass2026!\",\n  \"confirmPassword\": \"NewSecurePass2026!\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/reset-password",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            }
          }
        },
        {
          "name": "Get Dynamic Role-Based Menu Access",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/menu",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "auth", "menu"]
            }
          }
        }
      ]
    },
